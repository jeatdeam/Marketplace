# Copia este archivo como Jeatdeam/.env para desarrollo local (el .env NO se sube a git).
# En Render estas mismas variables se cargan en el panel: Service -> Environment.

# --- Dashboard y sesiones ---
DASHBOARD_CLAVE=cambia-esta-clave
SESSION_SECRET=una-cadena-larga-y-aleatoria

# --- Stripe ---
SECRET_KEY=sk_test_xxx
PUBLIC_KEY=pk_test_xxx
MONEDA_STRIPE=pen

# --- Correo (nodemailer) ---
EMAIL_USER=correo@gmail.com
EMAIL_PASS=contrasena-de-aplicacion

# --- Cloudinary (imagenes del dashboard) ---  ver integraciones/cloudinary/README.md
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CARPETA=jeatdeam

# --- Supabase (tienda, reclamos y mensajes) ---  ver integraciones/supabase/README.md
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=
